# Используем образ с Node.js
FROM node:20-slim

# Рабочая папка внутри контейнера
WORKDIR /app

# Копируем список зависимостей
COPY package*.json ./

# Устанавливаем их (внутри контейнера!)
RUN npm install

# Копируем остальной код
COPY . .

# Открываем порт для Vite
EXPOSE 5173

# Запускаем фронт так, чтобы он был доступен снаружи контейнера
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]